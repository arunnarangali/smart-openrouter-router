#!/usr/bin/env python3
"""Run OpenCode with smart-openrouter-router.

Starts the router on a free local port, runs OpenCode with provider overrides,
and stops the router when OpenCode exits.
"""

from __future__ import annotations

import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path
from urllib.error import URLError
from urllib.request import Request, urlopen


CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "smart-openrouter-router"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "smart-openrouter-router"
KEY_FILE = CONFIG_DIR / "api_key"
ACTIVE_FILE = CACHE_DIR / "active.json"
LOG_FILE = CACHE_DIR / "router.log"


def install_prefix() -> Path:
    return Path(__file__).resolve().parent.parent


SHARE_DIR = install_prefix() / "share" / "smart-openrouter-router"
ROUTER_SCRIPT = SHARE_DIR / "smart_router.py"


def eprint(message: str) -> None:
    sys.stderr.write(message + "\n")


def ensure_dirs() -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CACHE_DIR.mkdir(parents=True, exist_ok=True)


def read_api_key() -> str:
    saved_key = KEY_FILE.read_text(encoding="utf-8").strip() if KEY_FILE.exists() else ""
    env_key = os.environ.get("OPENROUTER_API_KEY", "").strip()

    if saved_key and env_key and saved_key != env_key:
        eprint("Saved key and OPENROUTER_API_KEY differ. Using saved key from config.")

    if saved_key:
        return saved_key
    if env_key:
        return env_key
    return ""


def pick_free_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def wait_for_status(port: int, timeout: float = 6.0) -> bool:
    deadline = time.time() + timeout
    url = f"http://127.0.0.1:{port}/status"
    while time.time() < deadline:
        try:
            req = Request(url)
            with urlopen(req, timeout=1.0):
                return True
        except (URLError, TimeoutError, OSError):
            time.sleep(0.2)
    return False


def start_router(api_key: str, port: int) -> subprocess.Popen:
    extra = {"SMART_ROUTER_REWRITE_MODEL": "1"}

    if not ROUTER_SCRIPT.exists():
        fallback = Path.home() / "smart_router.py"
        if fallback.exists():
            return start_router_from_path(api_key, port, fallback, extra_env=extra)
        raise FileNotFoundError(f"Router script not found: {ROUTER_SCRIPT}")

    return start_router_from_path(api_key, port, ROUTER_SCRIPT, extra_env=extra)


def start_router_from_path(api_key: str, port: int, script_path: Path, extra_env: dict | None = None) -> subprocess.Popen:
    env = os.environ.copy()
    env["OPENROUTER_API_KEY"] = api_key
    env["PROXY_PORT"] = str(port)
    env["SMART_ROUTER_LOG"] = str(LOG_FILE)
    if extra_env:
        env.update(extra_env)

    log_handle = LOG_FILE.open("a", encoding="utf-8")
    proc = subprocess.Popen(
        [sys.executable, str(script_path)],
        stdout=log_handle,
        stderr=subprocess.STDOUT,
        env=env,
    )
    return proc


def write_active(port: int, pid: int) -> None:
    payload = {
        "port": port,
        "pid": pid,
        "started_at": time.time(),
    }
    temp_path = ACTIVE_FILE.with_name(f"{ACTIVE_FILE.name}.tmp")
    temp_path.write_text(json.dumps(payload), encoding="utf-8")
    temp_path.replace(ACTIVE_FILE)


def clear_active_if_owned(pid: int) -> None:
    if not ACTIVE_FILE.exists():
        return
    try:
        payload = json.loads(ACTIVE_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return
    if int(payload.get("pid", 0) or 0) != int(pid):
        return
    try:
        ACTIVE_FILE.unlink()
    except OSError:
        pass


def stop_router(proc: subprocess.Popen) -> None:
    if proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=3)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait(timeout=2)


def _start_terminal_title_thread(port: int) -> None:
    """Daemon thread that polls /last and updates terminal title with real model."""
    def _poll():
        last_model = ""
        while True:
            time.sleep(1.0)
            try:
                req = Request(f"http://127.0.0.1:{port}/last")
                with urlopen(req, timeout=2) as resp:
                    data = json.loads(resp.read())
                final = data.get("final_model", "")
                if final and final != last_model:
                    last_model = final
                    sys.stderr.write(f"\033]0;opencode-free · {final}\007")
                    sys.stderr.flush()
            except Exception:
                pass
    t = threading.Thread(target=_poll, daemon=True)
    t.start()


def print_tail_log(lines: int = 40) -> None:
    if not LOG_FILE.exists():
        eprint("(router log not found)")
        return
    data = LOG_FILE.read_text(encoding="utf-8", errors="ignore").splitlines()
    tail = data[-lines:]
    eprint("\n--- Router log (tail) ---")
    for line in tail:
        eprint(line)
    eprint("--- end log ---\n")


def runtime_opencode_config(port: int, api_key: str) -> str:
    # OpenCode model entries use smart-router/* virtual IDs.
    # The router maps smart-router/* → ranked free-model selection
    # (see select_candidates in smart_router.py).
    payload = {
        "$schema": "https://opencode.ai/config.json",
        "provider": {
            "smart-router": {
                "npm": "@ai-sdk/openai-compatible",
                "name": "Smart Router",
                "options": {
                    "baseURL": f"http://127.0.0.1:{port}/v1",
                    "apiKey": api_key,
                },
                "models": {
                    "best": {"id": "smart-router/best", "name": "Smart Router — best (Free Auto)"},
                    "fast": {"id": "smart-router/fast", "name": "Smart Router — fast (Free Auto)"},
                },
            }
        },
    }
    return json.dumps(payload)


def main() -> int:
    if not shutil.which("opencode"):
        eprint("OpenCode not found in PATH. Install it and try again.")
        return 1

    ensure_dirs()
    api_key = read_api_key()
    if not api_key:
        eprint("OpenRouter API key not found. Run: smart-router setup")
        return 1

    port = pick_free_port()
    try:
        proc = start_router(api_key, port)
    except FileNotFoundError as exc:
        eprint(str(exc))
        return 1

    try:
        if not wait_for_status(port):
            eprint("Router failed to start or respond.")
            print_tail_log()
            stop_router(proc)
            return 1

        write_active(port, proc.pid)
        _start_terminal_title_thread(port)

        eprint("Tip: the real model appears in your terminal title and in each assistant message attribution. Run \"smart-router last --watch\" in another terminal for live details.")

        env = os.environ.copy()
        env["OPENROUTER_API_KEY"] = api_key
        env["OPENCODE_CONFIG_CONTENT"] = runtime_opencode_config(port, api_key)

        def handle_signal(_signum, _frame):
            stop_router(proc)
            sys.exit(130)

        signal.signal(signal.SIGINT, handle_signal)
        signal.signal(signal.SIGTERM, handle_signal)

        result = subprocess.run(["opencode", *sys.argv[1:]], env=env)
        return result.returncode
    finally:
        stop_router(proc)
        clear_active_if_owned(proc.pid)


if __name__ == "__main__":
    raise SystemExit(main())
